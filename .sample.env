# A random string that is used for the webhook verification request.
# We need to configure this on the Pages webhook as the verify token.
FB_WEBHOOK_VERIFY_TOKEN=<provide-any-secret-key>
FB_APP_SECRET=<fb-app-secret>
# Preferred Port
PORT=3000
# SLACK Incoming webhook url
SLACK_CHANNEL_URL=<slack-incoming-webhook-url>